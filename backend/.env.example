# ---------- Copy to backend/.env and fill in ----------

# Public HTTPS URL of this backend, reachable by Vobiz (e.g. an ngrok / cloudflared tunnel or your domain).
# Vobiz calls the answer/hangup webhooks and opens the audio websocket on this URL.
PUBLIC_BASE_URL=https://your-tunnel.example.com

# Frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# ---------- Security ----------
# The dashboard on THIS computer (localhost) needs no login. From anywhere else (another PC, a server)
# a login with this password is required; leave empty to allow local use only.
DASHBOARD_PASSWORD=
# Ask for the password even on localhost
REQUIRE_LOGIN_LOCAL=false
# Only Indian (+91) numbers can be stored and dialed unless this is true (toll-fraud guard)
ALLOW_INTERNATIONAL=false

# ---------- LLM brain (OpenAI) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=120
LLM_TEMPERATURE=0.6

# ---------- Sarvam AI (STT: Saaras v3 realtime, TTS: Bulbul v3) ----------
SARVAM_API_KEY=sk_m25zlpur_yKsGaPEvgjt69UTsZHvyfVu9
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_STT_MODE=codemix
SARVAM_TTS_MODEL=bulbul:v3

# ---------- Vobiz (Indian telephony) ----------
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=   
# Your Vobiz DID in E.164, e.g. +918071387423
VOBIZ_FROM_NUMBER=
VOBIZ_RECORD_CALLS=true
