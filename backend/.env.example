# ---------- Copy to backend/.env and fill in ----------

# Public HTTPS URL of this backend, reachable by the phone provider (e.g. an ngrok / cloudflared tunnel or
# your domain). Plivo / Vobiz call the answer/hangup webhooks and open the audio websocket on this URL.
PUBLIC_BASE_URL=https://your-tunnel.example.com

# Frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# ---------- Security ----------
# The dashboard on THIS computer (localhost) needs no login. From anywhere else (another PC, a server)
# a login with this password is required; leave empty to allow local use only.
DASHBOARD_PASSWORD=
# Ask for the password even on localhost
REQUIRE_LOGIN_LOCAL=false
# Only Indian (+91) numbers can be stored and dialed unless this is true (toll-fraud guard)
ALLOW_INTERNATIONAL=false

# ---------- LLM brain (OpenAI) ----------
OPENAI_API_KEY=
# gpt-4.1-mini starts answering ~0.2 s sooner than gpt-4o-mini, same reply quality (tools/llm_compare.py, 2026-11-20)
OPENAI_MODEL=gpt-4.1-mini
LLM_MAX_TOKENS=120
LLM_TEMPERATURE=0.6

# ---------- Sarvam AI (STT: Saaras v3 realtime, TTS: Bulbul v4 or v3, decided by the voice) ----------
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_STT_MODE=codemix
# The voice chosen in Settings -> Voice decides the TTS model. The "(v4)" voices (Sarika, Aparna, ...) always
# use bulbul:v4-flash. This line is only for the older v3 voices (suhani, priya, ...): keep it bulbul:v3,
# the v3 voice names do not exist in v4.
SARVAM_TTS_MODEL=bulbul:v3

# ---------- Phone provider ----------
# plivo = use Plivo (active) | vobiz = use Vobiz (kept: switch back by changing this one word)
TELEPHONY_PROVIDER=plivo

# ---------- Plivo (console.plivo.com -> Overview: Auth ID + Auth Token) ----------
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Your Plivo number in E.164, e.g. +918071387423 (India: a Plivo-rented Indian number, KYC approved)
PLIVO_FROM_NUMBER=
PLIVO_RECORD_CALLS=true

# ---------- Vobiz (Indian telephony, used when TELEPHONY_PROVIDER=vobiz) ----------
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=   
# Your Vobiz DID in E.164, e.g. +918071387423
VOBIZ_FROM_NUMBER=
VOBIZ_RECORD_CALLS=true
